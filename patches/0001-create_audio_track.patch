+    def _create_audio_track(self, index):
+        """Create a new audio track at the specified index.
+
+        LOCAL PATCH — not in upstream. Mirrors _create_midi_track exactly;
+        Live's Song API exposes create_audio_track with the same signature.
+        Without this the bridge can place clips but cannot make anywhere to
+        put them, so every stem import needed tracks added by hand first.
+        """
+        try:
+            # Create the track
+            self._song.create_audio_track(index)
+
+            # Get the new track
+            new_track_index = len(self._song.tracks) - 1 if index == -1 else index
+            new_track = self._song.tracks[new_track_index]
+
+            result = {
+                "index": new_track_index,
+                "name": new_track.name
+            }
+            return result
+        except Exception as e:
+            self.log_message("Error creating audio track: " + str(e))
+            raise
