#!/usr/bin/env bash
# roadie — one command for the whole stems-to-Live pipeline.
#
#   roadie split <file|url> [opts]   separate audio into stems        (yt2stems.sh)
#   roadie load <stems_dir> [opts]   load stems into the open Live set (stems2live.py)
#   roadie open <stems_dir> [opts]   new Live project from stems       (stems2als.sh)
#   roadie sections <stems> [opts]   detect song sections              (sections.py)
#   roadie drums <study | stems_dir> [--jobs N] [--json] [--no-write]  drum roles per stem and section (roadie_drums.py)
#   roadie study list | show <name> [--json] | tag <name> --key K | report <name> [--write] [--json]  studies, their saved analyses, one study's report (study.py, studyreport.py)
#   roadie key <study|stems> [--json]  estimate the key from the bass and synths stems (roadie_analysis/key.py)
#   roadie micro <study|stems> [--json] [--no-write]  bass, synths, vocal and drum patterns per section (roadie_analysis/micro.py)
#   roadie scenes <stems_dir> [opts] build a Session View grid         (session_view.py)
#   roadie als <stems_dir> [opts]    write a Live project file, no Live needed (als_writer.py)
#   roadie arrangement read --scenes A-B [--json] [--metrics] | ref <study>   Session scenes as an arrangement table; a study's structure (arrangement.py)
#   roadie batch plan|run|verify-sources ...   unattended overnight batch   (batch.py)
#   roadie stats                     summarise the local usage log
#   roadie mcp                       MCP server (stdio) for the analysis tools (roadie_mcp.py)
#
# `roadie <command> --help` shows that command's own options. Every argument
# after the command is passed through untouched, except that `split` turns a
# local path into `--file <path>` (a URL goes through as is).
#
# Each run on a source or stems dir appends one line to a local usage log
# (~/.local/state/roadie/usage.log; ROADIE_LOG=<file> moves it, ROADIE_LOG=
# turns it off). Nothing is sent anywhere.
#
# `split` writes to -o DIR, else to `out = DIR` in ~/.config/roadie/config
# (ROADIE_CONFIG=<file> moves it), else to the current directory.

set -euo pipefail

usage () { awk 'NR>1 && /^#/{sub(/^# ?/, ""); print; next} NR>1{exit}' "$SELF"; }

# The real location, through the ~/.local/bin symlink chain — same loop as the
# .sh scripts, since older macOS has no `readlink -f`.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINKDIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" == /* ]] || SELF="$LINKDIR/$SELF"
done
REPO="$(cd -P "$(dirname "$SELF")" && pwd)"

LOG="${ROADIE_LOG-${XDG_STATE_HOME:-${HOME:-}/.local/state}/roadie/usage.log}"

CONFIG="${ROADIE_CONFIG-${XDG_CONFIG_HOME:-${HOME:-}/.config}/roadie/config}"

# config_get <key> — the first `key = value` in the config file; a leading ~
# in the value expands to $HOME. Parsed, never sourced. Prints nothing if unset.
config_get () {
  [[ -n "$CONFIG" && -r "$CONFIG" ]] || return 0
  local k v
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    k="${k//[[:space:]]/}"
    [[ "$k" == "$1" ]] || continue
    v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    if [[ "$v" == "~" || "$v" == "~/"* ]]; then v="${HOME:-}${v#\~}"; fi
    printf '%s' "$v"; return
  done < "$CONFIG"
}

# One tab-separated line per run: time, command, exit code, seconds, target.
# Best effort — a log that cannot be written must never fail the command.
log_run () {
  [[ -n "$LOG" && -n "$2" ]] || return 0
  { mkdir -p "$(dirname "$LOG")" &&
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$3" "$4" \
      "$(printf '%s' "$2" | tr -d '\000-\037')" >> "$LOG"; } 2>/dev/null || true
}

# run_logged <command> <target> <program> [args...] — runs the program in place
# of the old `exec`, then logs it and exits with its status.
run_logged () {
  local name="$1" target="$2" rc=0 t0=$SECONDS
  shift 2
  "$@" || rc=$?
  log_run "$name" "$target" "$rc" $(( SECONDS - t0 ))
  exit "$rc"
}

# The first argument that is a directory, made absolute: the stems dir.
first_dir () {
  local a
  for a in "$@"; do
    if [[ -d "$a" ]]; then (cd -P "$a" && pwd); return; fi
  done
}

[[ $# -gt 0 ]] || { usage; exit 0; }
cmd="$1"; shift

case "$cmd" in
  -h|--help) usage; exit 0 ;;
  split)
    # The first bare argument is the source. An existing path is a local file
    # (--file); something URL-shaped that is not on disk — with a scheme, or a
    # bare host like youtu.be/x or www.youtube.com/... — goes through as a URL,
    # given https:// if it had none. Anything else is taken as a file, so a
    # typo gets yt2stems' "no such file" rather than a network fetch. `--`
    # ends option parsing here and is not passed on (yt2stems has no `--`).
    args=() src_done=0 opts_done=0 src= out_given=0
    while [[ $# -gt 0 ]]; do
      if [[ $opts_done -eq 0 ]]; then
        case "$1" in
          --) opts_done=1; shift; continue ;;
          --file|-i) args+=("$1" "${2:-}"); src_done=1; src="${2:-}"; shift $(( $# > 1 ? 2 : 1 )); continue ;;
          -o|-m) args+=("$1" "${2:-}"); [[ "$1" == -o ]] && out_given=1; shift $(( $# > 1 ? 2 : 1 )); continue ;;
          -*) args+=("$1"); shift; continue ;;
        esac
      fi
      if [[ $src_done -eq 1 ]]; then
        args+=("$1")
      elif [[ -e "$1" ]]; then
        args+=(--file "$1"); src="$1"
      elif [[ "$1" == *://* ]]; then
        args+=("$1"); src="$1"
      elif [[ "$1" =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+/ ]]; then
        args+=("https://$1"); src="https://$1"
      else
        args+=(--file "$1"); src="$1"
      fi
      src_done=1; shift
    done
    if [[ $out_given -eq 0 ]]; then
      cfg_out="$(config_get out)"
      # The configured folder is a studies library: <Artist>/<Title>/ per track (-a).
      [[ -z "$cfg_out" ]] || args+=(-o "$cfg_out" -a)
    fi
    # A local source is logged by absolute path; --help and bare errors have none.
    if [[ -n "$src" && "$src" != *://* && -e "$src" ]]; then
      src="$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
    fi
    # The separation is the heavy part: take the machine-wide lock first. jobqueue.py replaces itself
    # with yt2stems.sh, which keeps the lock until it and its children are gone. No lock for --help or
    # a run with no source (they end at once); ROADIE_NO_QUEUE=1 skips it. The usage log's seconds
    # include the wait.
    queue=()
    if [[ -n "$src" ]]; then
      queue=(1)
      for a in ${args[@]+"${args[@]}"}; do [[ "$a" == -h || "$a" == --help ]] && queue=(); done
    fi
    if [[ ${#queue[@]} -gt 0 ]]; then
      PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
      queue=("$PY" -I "$REPO/roadie_analysis/jobqueue.py" run "roadie split $src" --)
    fi
    run_logged split "$src" ${queue[@]+"${queue[@]}"} "$REPO/yt2stems.sh" ${args[@]+"${args[@]}"} ;;
  load)     run_logged load     "$(first_dir "$@")" "$REPO/stems2live.py" "$@" ;;
  open)     run_logged open     "$(first_dir "$@")" "$REPO/stems2als.sh" "$@" ;;
  sections) run_logged sections "$(first_dir "$@")" "$REPO/sections.py" "$@" ;;
  study)
    # Read-only except `tag`, which writes one study.json, and `report --write`, which writes report.md; not logged.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/study.py" "$@" ;;
  drums)
    # Writes drums.json and drum_roles/ into the stems folder; not logged.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/roadie_drums.py" "$@" ;;
  key)
    # Read-only (a pCloud study's two stems are copied to a temp folder and deleted); not logged.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/roadie_analysis/key.py" "$@" ;;
  micro)
    # Writes micro.json into the stems folder (a pCloud study's stems are copied to a temp folder and deleted); not logged.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/roadie_analysis/micro.py" "$@" ;;
  scenes)   run_logged scenes   "$(first_dir "$@")" "$REPO/session_view.py" "$@" ;;
  als)      run_logged als      "$(first_dir "$@")" "$REPO/als_writer.py" "$@" ;;
  arrangement) run_logged arrangement "" "$REPO/arrangement.py" "$@" ;;
  batch)
    # Not logged to the usage log: each track it processes calls roadie itself.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/batch.py" "$@" ;;
  mcp)
    # Not logged: an MCP client starts it and keeps it running. stdout is the protocol.
    PY="$REPO/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
    exec "$PY" "$REPO/roadie_mcp.py" "$@" ;;
  stats)
    if [[ -z "$LOG" ]]; then echo "usage log is off (ROADIE_LOG is empty)"; exit 0; fi
    if [[ ! -s "$LOG" ]]; then echo "no usage logged yet ($LOG)"; exit 0; fi
    awk -F'\t' -v logfile="$LOG" '
      { runs[$2]++; if ($3 != 0) bad[$2]++
        else if (!(($2, $5) in seen)) { seen[$2, $5] = 1; distinct[$2]++ }
        if (first == "") first = $1; last = $1; n++ }
      END {
        printf "roadie usage — %s\n  %d runs, %s to %s\n", logfile, n, first, last
        split("split load open sections scenes als", order, " ")
        for (i = 1; i in order; i++) { c = order[i]; if (!(c in runs)) continue
          printf "  %-9s %3d runs, %d failed — %d distinct %s\n", c, runs[c], bad[c], distinct[c],
            (c == "split" ? "sources" : "stems dirs") } }' "$LOG" ;;
  *) echo "roadie: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
